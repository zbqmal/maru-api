generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroupMemberRole {
  LEADER
  MEMBER
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique @db.VarChar(320)
  passwordHash    String    @map("password_hash")
  name            String    @db.VarChar(100)
  birthday        DateTime? @db.Date
  profileImageKey String?   @map("profile_image_key") @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  groupMemberships    GroupMember[]
  createdGroupQuestions GroupQuestion[]
  diaryEntries        DiaryEntry[]

  @@map("users")
}

model Group {
  id          String            @id @default(cuid())
  name        String            @db.VarChar(100)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  memberships GroupMember[]
  invitations GroupInvitation[]
  groupQuestions GroupQuestion[]
  diaryEntries   DiaryEntry[]

  @@map("groups")
}

model GroupMember {
  id        String          @id @default(cuid())
  groupId   String          @map("group_id")
  userId    String          @map("user_id")
  role      GroupMemberRole @default(MEMBER)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, role])
  @@index([groupId, createdAt])
  @@map("group_members")
}

model Session {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([userId, revokedAt, expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model GroupInvitation {
  id           String    @id @default(cuid())
  groupId      String    @map("group_id")
  invitedEmail String    @map("invited_email") @db.VarChar(320)
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at")
  acceptedAt   DateTime? @map("accepted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  group        Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([groupId, invitedEmail])
  @@index([expiresAt])
  @@map("group_invitations")
}

model GroupQuestion {
  id              String   @id @default(cuid())
  groupId         String   @map("group_id")
  question        String   @db.VarChar(200)
  displayOrder    Int      @map("display_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdByUser   User     @relation(fields: [createdByUserId], references: [id])
  answers         Answer[]

  @@unique([groupId, displayOrder])
  @@index([groupId, isActive])
  @@map("group_questions")
}

enum QuestionType {
  CUSTOM
  DAILY
}

model DiaryEntry {
  id        String   @id @default(cuid())
  groupId   String   @map("group_id")
  userId    String   @map("user_id")
  diaryDate DateTime @map("diary_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   Answer[]

  @@unique([groupId, userId, diaryDate])
  @@index([groupId, diaryDate])
  @@index([userId, diaryDate])
  @@map("diary_entries")
}

model Answer {
  id              String       @id @default(cuid())
  diaryEntryId    String       @map("diary_entry_id")
  questionType    QuestionType @map("question_type")
  groupQuestionId String?      @map("group_question_id")
  body            String       @db.VarChar(2000)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  diaryEntry      DiaryEntry   @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)
  groupQuestion   GroupQuestion? @relation(fields: [groupQuestionId], references: [id])

  @@unique([diaryEntryId, groupQuestionId])
  @@index([diaryEntryId])
  @@map("answers")
}
