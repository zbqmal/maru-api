NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/maru_dev?schema=public
TEST_DATABASE_URL=postgresql://<user>:<password>@localhost:5432/maru_test?schema=public

# Comma-separated allowlist of browser origins permitted to call this API.
# Defaults to http://localhost:3000 outside production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Resend transactional email
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Maru <noreply@yourdomain.com>

# OpenAI — required for daily question generation
OPENAI_API_KEY=sk-your_openai_api_key_here

# AWS S3 media storage (server-side only; never expose these credentials to clients)
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=maru-media
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
