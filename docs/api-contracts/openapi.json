          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "Group leader role required."
          },
          "404": {
            "description": "Group not found."
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Update a group (leader only)",
        "tags": [
          "Groups"
        ]
      },
      "delete": {
        "operationId": "GroupController_deleteGroup",
