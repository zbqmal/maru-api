  "info": {
    "title": "MARU API",
    "description": "MARU backend API documentation",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "maru_session"
      }
    },
    "schemas": {
      "CreateGroupDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the group",
            "example": "Family",
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ]
      },
      "GroupMemberUserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "profileImageKey": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "profileImageKey"
        ]
      },
      "GroupMemberResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "LEADER",
              "MEMBER"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/GroupMemberUserResponseDto"
          }
        },
        "required": [
          "id",
          "userId",
          "role",
          "createdAt",
          "updatedAt",
          "user"
        ]
      },
      "GroupResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GroupMemberResponseDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "createdAt",
          "updatedAt",
          "memberships"
        ]
      },
      "UpdateGroupDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The updated name of the group",
            "example": "Family",
            "maxLength": 100
          }
        }
      },
      "TransferLeadershipDto": {
        "type": "object",
        "properties": {
          "newLeaderId": {
            "type": "string",
            "description": "User ID of the member to promote to leader"
          }
        },
        "required": [
          "newLeaderId"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "maxLength": 320
          },
          "password": {
            "type": "string",
            "example": "Str0ngPassword!",
            "minLength": 8,
            "maxLength": 255,
            "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[^A-Za-z0-9]).+$"
          },
          "name": {
            "type": "string",
            "example": "Maru User",
            "maxLength": 100
          }
        },
        "required": [
          "email",
          "password",
          "name"
        ]
      },
      "AuthUserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "birthday": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "profileImageKey": {
            "type": "object",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "birthday",
          "profileImageKey",
          "createdAt",
          "updatedAt"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "maxLength": 320
          },
          "password": {
            "type": "string",
            "example": "Str0ngPassword!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The password reset token received by email"
          },
          "newPassword": {
            "type": "string",
            "example": "NewStr0ngPassword!",
            "minLength": 8
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-10T12:34:56.789Z"
          },
          "uptime": {
            "type": "number",
            "example": 123.45
          },
          "database": {
            "type": "object",
            "example": {
              "status": "up"
            }
          }
        },
        "required": [
          "status",
          "timestamp",
          "uptime",
          "database"
        ]
      },
      "ProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "birthday": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "profileImageKey": {
            "type": "object",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "birthday",
          "profileImageKey",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateNameDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Maru User",
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateBirthdayDto": {
        "type": "object",
        "properties": {
          "birthday": {
            "type": "string",
            "example": "1990-05-20",
            "nullable": true,
            "format": "date"
          }
        },
        "required": [
          "birthday"
        ]
      }
    }
  }
}
